meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: http://localhost:5243/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "testuser",
    "password": "testpass123"
  }
}

script:post-response {
  const cookies = res.headers['set-cookie'];
  if (cookies) {
    const match = cookies.toString().match(/authToken=([^;]+)/);
    if (match) {
      bru.setEnvVar("authToken", match[1]);
    }
  }
}


settings {
  encodeUrl: true
  timeout: 0
}
